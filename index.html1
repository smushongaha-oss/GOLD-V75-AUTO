<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Focus Trade — Professional Trading Terminal</title>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;900&family=Share+Tech+Mono&family=Barlow:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #0a0b0e;
      --surface: #13151a;
      --surface2: #1a1d25;
      --border: #2a2d38;
      --blue: #3b82f6;
      --blue-glow: rgba(59,130,246,0.25);
      --text: #e8eaf0;
      --muted: #6b7280;
      --accent: #60a5fa;
    }

    html, body {
      height: 100%;
      background: var(--bg);
      color: var(--text);
      font-family: 'Barlow', sans-serif;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      overflow: hidden;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(59,130,246,0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(59,130,246,0.04) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none;
      z-index: 0;
    }

    body::after {
      content: '';
      position: fixed;
      top: -200px;
      left: -200px;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(59,130,246,0.12) 0%, transparent 70%);
      pointer-events: none;
      z-index: 0;
    }

    .container {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 420px;
      padding: 40px 24px 48px;
      display: flex;
      flex-direction: column;
      gap: 40px;
      animation: fadeUp 0.6s ease both;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .logo {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .logo-focus {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 900;
      font-size: clamp(52px, 14vw, 72px);
      color: #fff;
      letter-spacing: 0.04em;
      line-height: 1;
      text-transform: uppercase;
    }

    .logo-trade {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 900;
      font-size: clamp(52px, 14vw, 72px);
      color: var(--blue);
      letter-spacing: 0.04em;
      line-height: 1;
      text-transform: uppercase;
      text-shadow: 0 0 40px var(--blue-glow);
    }

    .logo-sub {
      margin-top: 10px;
      font-family: 'Share Tech Mono', monospace;
      font-size: 12px;
      letter-spacing: 0.2em;
      color: var(--muted);
      text-transform: uppercase;
    }

    .logo-sub span { color: var(--blue); }

    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 28px 24px;
      display: flex;
      flex-direction: column;
      gap: 24px;
      animation: fadeUp 0.6s 0.1s ease both;
    }

    .label {
      font-family: 'Share Tech Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.18em;
      color: var(--muted);
      text-transform: uppercase;
      margin-bottom: 12px;
    }

    .broker-grid {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .broker-btn {
      flex: 1;
      min-width: 60px;
      padding: 10px 8px;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 10px;
      color: var(--muted);
      font-family: 'Share Tech Mono', monospace;
      font-size: 12px;
      letter-spacing: 0.08em;
      cursor: pointer;
      transition: all 0.18s ease;
      text-align: center;
    }

    .broker-btn:hover {
      border-color: var(--blue);
      color: var(--accent);
    }

    .broker-btn.active {
      background: rgba(59,130,246,0.1);
      border-color: var(--blue);
      color: #fff;
      box-shadow: 0 0 16px var(--blue-glow);
    }

    .token-section { display: flex; flex-direction: column; }

    .token-input {
      width: 100%;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 14px 16px;
      color: var(--text);
      font-family: 'Share Tech Mono', monospace;
      font-size: 13px;
      letter-spacing: 0.04em;
      outline: none;
      transition: border-color 0.18s, box-shadow 0.18s;
    }

    .token-input::placeholder { color: var(--muted); }

    .token-input:focus {
      border-color: var(--blue);
      box-shadow: 0 0 0 3px var(--blue-glow);
    }

    .token-hint {
      margin-top: 8px;
      font-size: 11.5px;
      color: var(--muted);
      line-height: 1.5;
    }

    .token-hint a {
      color: var(--accent);
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    .connect-btn {
      width: 100%;
      padding: 18px;
      background: linear-gradient(135deg, #2563eb, #3b82f6);
      border: none;
      border-radius: 14px;
      color: #fff;
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 700;
      font-size: 20px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      box-shadow: 0 4px 32px rgba(59,130,246,0.35);
      transition: all 0.2s ease;
      animation: fadeUp 0.6s 0.2s ease both;
      position: relative;
      overflow: hidden;
    }

    .connect-btn::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(255,255,255,0.1), transparent);
      opacity: 0;
      transition: opacity 0.2s;
    }

    .connect-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 40px rgba(59,130,246,0.5); }
    .connect-btn:hover::after { opacity: 1; }
    .connect-btn:active { transform: translateY(0); }
    .connect-btn.loading { pointer-events: none; opacity: 0.8; }

    .bolt { font-size: 22px; }

    .footer-note {
      text-align: center;
      font-size: 12px;
      color: var(--muted);
      letter-spacing: 0.03em;
      animation: fadeUp 0.6s 0.3s ease both;
    }
  </style>
</head>
<body>
  <div class="container">

    <div class="logo">
      <div class="logo-focus">FOCUS</div>
      <div class="logo-trade">TRADE</div>
      <div class="logo-sub"><span>//</span> PROFESSIONAL TRADING TERMINAL</div>
    </div>

    <div class="card">
      <div>
        <div class="label">Select Broker</div>
        <div class="broker-grid" id="brokerGrid">
          <button class="broker-btn active" data-broker="DERIV">DERIV</button>
          <button class="broker-btn" data-broker="WELTRADE">WELTRADE</button>
          <button class="broker-btn" data-broker="XM">XM</button>
          <button class="broker-btn" data-broker="EXNESS">EXNESS</button>
          <button class="broker-btn" data-broker="FBS">FBS</button>
        </div>
      </div>

      <div class="token-section" id="tokenSection">
        <div class="label" id="tokenLabel">DERIV API TOKEN</div>
        <input
          class="token-input"
          id="tokenInput"
          type="password"
          placeholder="Paste Read + Trade token..."
          autocomplete="off"
          spellcheck="false"
        />
        <p class="token-hint" id="tokenHint">
          Get token at <a href="https://app.deriv.com" target="_blank">app.deriv.com</a>
          → API Token → Read + Trade
        </p>
      </div>
    </div>

    <button class="connect-btn" id="connectBtn" onclick="handleConnect()">
      <span class="bolt">⚡</span> CONNECT
    </button>

    <p class="footer-note">Works on iPhone, iPad &amp; Mac — no installation needed</p>

  </div>

  <script>
    const brokerHints = {
      DERIV:    { label: 'DERIV API TOKEN',    placeholder: 'Paste Read + Trade token...', hint: 'Get token at <a href="https://app.deriv.com" target="_blank">app.deriv.com</a> → API Token → Read + Trade' },
      WELTRADE: { label: 'WELTRADE API KEY',   placeholder: 'Paste your Weltrade API key...', hint: 'Get key at <a href="https://weltrade.com" target="_blank">weltrade.com</a> → Account → API' },
      XM:       { label: 'XM MT4/MT5 TOKEN',   placeholder: 'Paste your XM token...', hint: 'Get token at <a href="https://xm.com" target="_blank">xm.com</a> → Client Area → API' },
      EXNESS:   { label: 'EXNESS API TOKEN',   placeholder: 'Paste your Exness API key...', hint: 'Get key at <a href="https://exness.com" target="_blank">exness.com</a> → Account Settings → API' },
      FBS:      { label: 'FBS API TOKEN',      placeholder: 'Paste your FBS token...', hint: 'Get token at <a href="https://fbs.com" target="_blank">fbs.com</a> → Personal Area → API' },
    };

    let activeBroker = 'DERIV';

    document.getElementById('brokerGrid').addEventListener('click', e => {
      const btn = e.target.closest('.broker-btn');
      if (!btn) return;
      document.querySelectorAll('.broker-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeBroker = btn.dataset.broker;
      const info = brokerHints[activeBroker];
      document.getElementById('tokenLabel').textContent = info.label;
      document.getElementById('tokenInput').placeholder = info.placeholder;
      document.getElementById('tokenHint').innerHTML = info.hint;
      document.getElementById('tokenInput').value = '';
    });

    function handleConnect() {
      const token = document.getElementById('tokenInput').value.trim();
      const btn = document.getElementById('connectBtn');
      if (!token) {
        document.getElementById('tokenInput').style.borderColor = '#ef4444';
        document.getElementById('tokenInput').style.boxShadow = '0 0 0 3px rgba(239,68,68,0.2)';
        setTimeout(() => {
          document.getElementById('tokenInput').style.borderColor = '';
          document.getElementById('tokenInput').style.boxShadow = '';
        }, 1500);
        return;
      }
      btn.classList.add('loading');
      btn.innerHTML = '<span class="bolt">⚡</span> CONNECTING...';
      setTimeout(() => {
        btn.classList.remove('loading');
        btn.innerHTML = '<span class="bolt">⚡</span> CONNECT';
        alert(`Connected to ${activeBroker}!`);
      }, 2000);
    }
  </script>
</body>
</html>